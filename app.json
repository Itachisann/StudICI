{
  "expo": {
    "name": "StudICI",
    "slug": "StudICI",
    "version": "1.9.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studici",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vitor.studici",
      "buildNumber": "70",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "it",
        "CFBundleLocalizations": [
          "it",
          "it_IT"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "StudICI utilizza le sveglie di sistema per svegliarti automaticamente in base all'orario del treno ideale per la tua prima lezione.",
        "NSRemindersUsageDescription": "StudICI utilizza i promemoria e gli avvisi nativi per le sveglie automatiche delle lezioni.",
        "NSRemindersFullAccessUsageDescription": "StudICI utilizza i promemoria e gli avvisi nativi per le sveglie automatiche delle lezioni.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "viaggiatreno.it": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSAllowsArbitraryLoads": true
            }
          }
        },
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "trenitalia",
          "sidestore",
          "altstore",
          "livecontainer"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#822433",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 63,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.vitor.studici"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-calendar",
        {
          "calendarPermission": "L'app ha bisogno di accedere al calendario per sincronizzare l'orario delle lezioni.",
          "remindersPermission": "L'app utilizza i promemoria per gestire gli avvisi e le sveglie automatiche."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-bottom-tabs",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c4dd46a-7100-449d-96af-5c204b27267a"
      }
    }
  }
}
